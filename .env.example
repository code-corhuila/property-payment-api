# Names and placeholders only: never a real value. Copy to .env for local runs.
PORT=3003
# Public key of identity-service (one line, \n escapes) — or JWT_PUBLIC_KEY_FILE.
# In develop, property-infra-postgres/scripts/dev-keys.sh generates a pair.
JWT_PUBLIC_KEY=
JWT_PUBLIC_KEY_FILE=
# The schema payment (property-payment-db). Required: without it the service does not start.
# PERSISTENCE=memory (in-memory, nothing persists) is for tests and local development only.
PERSISTENCE=postgres
DATABASE_URL=
DATABASE_USER=payment_app
DATABASE_PASSWORD=
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=5000
# Stripe in test mode (ADR-003). The secret key (sk_test_...) goes only in .env, never versioned.
STRIPE_URL=https://api.stripe.com
STRIPE_SECRET_KEY=
PASARELA_TIMEOUT_MS=3000
PASARELA_TOTAL_MS=8000
PASARELA_MAX_ATTEMPTS=2
PASARELA_CB_FAILURES=5
PASARELA_CB_OPEN_MS=30000
# Integration tests run only when TEST_DATABASE_URL is set (Annex C); scripts/test-db.sh prepares one.
TEST_DATABASE_URL=
TEST_DATABASE_USER=payment_app
TEST_DATABASE_PASSWORD=
